# === Supabase ===
# Los encuentras en tu proyecto de Supabase > Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# === Correo (Brevo) ===
# Crea una cuenta gratis en https://app.brevo.com, verifica un correo remitente
# (Senders, Domains & Dedicated IPs > Senders) y genera una SMTP key en
# SMTP & API > SMTP.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=tu_correo_de_brevo@gmail.com
SMTP_PASSWORD=xxxxxxxxxxxxxxxx

# El correo remitente que verificaste en Brevo (el que verá la gente enviando)
MAIL_FROM_EMAIL=tu_correo_verificado@gmail.com
# Nombre que verá la gente como remitente
MAIL_FROM_NAME="Firma Fácil"

# Tu correo (el que recibe copia del documento firmado)
OWNER_EMAIL=tu_correo@gmail.com

# === Seguridad del panel de envío ===
# Usuario y clave para entrar a la app (protege /  y /panel)
ADMIN_USER=admin
ADMIN_PASSWORD=cambia-esta-clave

# === URL pública de la app ===
# La URL donde quedará publicada en Vercel, ej: https://firma-facil.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000
