# === Supabase ===
# Los encuentras en tu proyecto de Supabase > Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# === Correo (Brevo) ===
# Crea una cuenta gratis en https://app.brevo.com, verifica un correo remitente
# (Senders, Domains & Dedicated IPs > Senders) y genera una SMTP key en
# SMTP & API > SMTP.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=tu_correo_de_brevo@gmail.com
SMTP_PASSWORD=xxxxxxxxxxxxxxxx

# El correo remitente que verificaste en Brevo (el que verá la gente enviando)
MAIL_FROM_EMAIL=tu_correo_verificado@gmail.com
# Nombre que verá la gente como remitente
MAIL_FROM_NAME="Más Baratas Droguerías"

# Tu correo (el que recibe copia del documento firmado)
OWNER_EMAIL=tu_correo@gmail.com

# === Usuarios iniciales del panel ===
# Los usuarios viven en la tabla app_users de Supabase (se gestionan desde
# la pantalla "Usuarios", solo la administradora). Estas variables se usan
# UNA SOLA VEZ: la primera vez que alguien inicia sesión con la tabla
# vacía, se copian a la base de datos (con la clave cifrada). El usuario 1
# queda como administradora y el 2 como usuario normal. Después ya no se
# leen y se pueden borrar de Vercel.
ADMIN_USER=Kata Vanegas
ADMIN_PASSWORD=cambia-esta-clave

# Segundo usuario inicial (opcional).
ADMIN_USER_2=
ADMIN_PASSWORD_2=

# === URL pública de la app ===
# La URL donde quedará publicada en Vercel, ej: https://firma-facil.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000
